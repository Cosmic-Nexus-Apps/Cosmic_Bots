# ── Discord (boții Python) ────────────────────────────────────────────────────
# Webhook-urile se creează din Discord → Channel → Integrations → Webhooks.
# Nu commita niciodată fișierul .env: el este ignorat de git.
EVENTS_BOT_DISCORD_WEBHOOK_URL=
EVENTS_BOT_DISCORD_ROLE_ID=
DEEP_SPACE_BOT_DISCORD_WEBHOOK_URL=
DEEP_SPACE_BOT_DISCORD_ROLE_ID=
SPACE_QUIZ_BOT_DISCORD_WEBHOOK_URL=
SPACE_QUIZ_BOT_DISCORD_ROLE_ID=
SPACE_HISTORY_BOT_DISCORD_WEBHOOK_URL=
SPACE_HISTORY_BOT_DISCORD_ROLE_ID=

# Fallback comun (opțional)
DISCORD_WEBHOOK_URL=
DISCORD_ROLE_ID=

# ── API-uri externe ──────────────────────────────────────────────────────────
GEMINI_API_KEY=
NASA_API_KEY=DEMO_KEY
TEST_MODE=FALSE

# ── cosmic-alerts (Node.js) ──────────────────────────────────────────────────
# TNS: alege UNUL dintre moduri.
#   user (fără API key): TNS_USER_ID + TNS_USER_NAME
#   bot  (automatizare): TNS_BOT_ID + TNS_BOT_NAME + TNS_API_KEY
TNS_USER_ID=
TNS_USER_NAME=
TNS_BOT_ID=
TNS_BOT_NAME=
TNS_API_KEY=

# Opțional: fără el, feed-ul se actualizează normal, dar nu se trimit notificări push.
FIREBASE_SERVICE_ACCOUNT=
