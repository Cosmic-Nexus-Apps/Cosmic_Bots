# ── Discord webhooks (Python bots) ────────────────────────────────────────────
# Create them in Discord: Channel → Integrations → Webhooks.
# Copy this file to `.env` and fill in the values. Never commit real credentials:
# `.env` is git-ignored. GitHub Actions reads the same values from Repository Secrets.
EVENTS_BOT_DISCORD_WEBHOOK_URL=
EVENTS_BOT_DISCORD_ROLE_ID=
DEEP_SPACE_BOT_DISCORD_WEBHOOK_URL=
DEEP_SPACE_BOT_DISCORD_ROLE_ID=
SPACE_QUIZ_BOT_DISCORD_WEBHOOK_URL=
SPACE_QUIZ_BOT_DISCORD_ROLE_ID=
SPACE_HISTORY_BOT_DISCORD_WEBHOOK_URL=
SPACE_HISTORY_BOT_DISCORD_ROLE_ID=

# Optional shared fallback used by the Python bots when a per-bot value is absent.
DISCORD_WEBHOOK_URL=
DISCORD_ROLE_ID=

# ── External APIs ─────────────────────────────────────────────────────────────
# Google AI Studio key (Gemini) — used for news summaries, the daily quiz and
# urgency classification. NASA_API_KEY defaults to the public DEMO_KEY.
GEMINI_API_KEY=
NASA_API_KEY=DEMO_KEY
TEST_MODE=FALSE

# ── cosmic-alerts (Node.js) ───────────────────────────────────────────────────
# TNS access (public staged CSV downloads) supports two authentication modes.
# Use exactly one of them:
#   user mode (no API key): TNS_USER_ID + TNS_USER_NAME
#   bot mode (recommended for automation): TNS_BOT_ID + TNS_BOT_NAME + TNS_API_KEY
TNS_USER_ID=
TNS_USER_NAME=
TNS_BOT_ID=
TNS_BOT_NAME=
TNS_API_KEY=

# Optional Firebase service account (full JSON, single line).
# Without it the public feed still updates; only FCM push notifications are skipped.
FIREBASE_SERVICE_ACCOUNT=
